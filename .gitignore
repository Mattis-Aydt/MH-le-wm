*cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Checkpoints and data
checkpoints/
*.ckpt
*.pt
*.pth
data/
datasets/
cache/

# Logs and outputs
wandb/
logs/
*.log
outputs/
eval_results/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hydra
.hydra/
EOF

pusht_results.txt
wandb_resume.json